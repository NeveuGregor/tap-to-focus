<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <!-- Rend visibles les applis lançables (Android 11+), sans QUERY_ALL_PACKAGES -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Pour trouver le lanceur par défaut, qu'on ne bloque jamais -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Tap to Focus"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- singleTop : le scan NFC arrive dans onNewIntent sans recréer l'activité -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Scan d'un tag écrit par l'appli, depuis l'écran d'accueil ou une autre appli.
                 Le type MIME doit être identique à TYPE_MIME (TagNfc.kt), en minuscules. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.neveugregor.taptofocus" />
            </intent-filter>
        </activity>

        <!-- Écran de blocage : tâche à part, absent des récents, une seule instance -->
        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <!-- Service d'accessibilité : seul le système peut s'y lier (permission BIND_ACCESSIBILITY_SERVICE) -->
        <service
            android:name=".BlocageService"
            android:exported="false"
            android:label="Tap to Focus"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
